# 로컬 실행용. 이 파일을 .env로 복사해서 값을 채운다. (.env는 git에 올라가지 않음)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# 카카오 개발자 콘솔 > 앱 > 플랫폼 키 > REST API 키
KAKAO_REST_API_KEY=
# 플랫폼 키 > REST API 키 ⋮ > 수정 > 클라이언트 시크릿
KAKAO_CLIENT_SECRET=
# 같은 화면의 카카오 로그인 리다이렉트 URI에 등록한 주소와 똑같이
KAKAO_REDIRECT_URI=https://localhost
# python -m assistant.kakao_auth 로 받은 값
KAKAO_REFRESH_TOKEN=

# 구글 캘린더 '비공개 주소(iCal 형식)', 여러 개면 쉼표로 구분
CALENDAR_ICS_URLS=
